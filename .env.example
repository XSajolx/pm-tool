# ---- Database (Neon / Supabase / RDS) ----
DATABASE_URL=postgres://user:password@host:5432/pm_tool

# ---- API ----
API_PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Auth (Supabase Auth) ----
# Supabase is the identity provider only; app data lives in DATABASE_URL above.
# The API needs just this URL: tokens are ES256-signed and verified against the
# project's public JWKS, so there is no shared secret to keep here.
SUPABASE_URL=https://<project-ref>.supabase.co

# ---- Files (S3-compatible: Cloudflare R2 or S3) ----
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pm-tool-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Without S3_* the API stores files on disk here (default: apps/api/uploads)
UPLOAD_DIR=
# Base URL browsers use to reach the API (for local-storage file links)
PUBLIC_API_URL=http://localhost:3333

# ---- Email (Postmark) ----
POSTMARK_TOKEN=

# ---- Observability ----
SENTRY_DSN=

# ---- Web (Vite) ----
VITE_API_URL=http://localhost:3333
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key — safe to ship to the browser (it grants nothing on its own).
VITE_SUPABASE_ANON_KEY=

# ---- Integrations (row 112): Google Drive / Dropbox OAuth apps ----
# Google: OAuth client (Web application) with redirect URI <PUBLIC_API_URL>/api/integrations/google_drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dropbox: App Console app with redirect URI <PUBLIC_API_URL>/api/integrations/dropbox/callback
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Key for encrypting stored provider tokens (any long random string; falls back to a hash of DATABASE_URL)
INTEGRATIONS_SECRET=
# Where the browser lands after connecting (defaults to the first CORS_ORIGIN)
WEB_URL=
